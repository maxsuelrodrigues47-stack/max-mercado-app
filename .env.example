# Copie este arquivo para .env no computador ou configure estas variáveis na hospedagem.
PORT=3000
DATABASE_URL=postgres://usuario:senha@host:5432/banco
# Em produção, use uma chave longa e aleatória.
JWT_SECRET=troque-por-uma-chave-longa-aleatoria
# Dados do primeiro mercado criado automaticamente ao iniciar
DEFAULT_STORE_NAME=Max Mercado
DEFAULT_STORE_SLUG=max-mercado
DEFAULT_STORE_WHATSAPP=5516993702260
DEFAULT_ADMIN_EMAIL=admin@maxmercado.local
DEFAULT_ADMIN_PASSWORD=TroqueEstaSenha123!
# Segredo de plataforma para criar novos mercados por endpoint administrativo
PLATFORM_ADMIN_KEY=troque-por-outra-chave-longa
